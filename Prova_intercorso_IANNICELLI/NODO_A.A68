ORG $8200

MAIN        JSR     INIT
LOOP        JMP     LOOP

INIT:
        * SETUP PIA B
        MOVE.W      #0, PCRA_B
        MOVE.W      #0, PRA_B
        MOVE.W      #00100101,  PCRA_B

        * SETUP PIA C
        MOVE.W      #0, PCRA_C
        MOVE.W      #0, PRA_C
        MOVE.W      #0, PCRA_C

        * ENABLE INTERRUPTS E USERMODE
        MOVE.W      SR, D0
        ANDI.W      #D8FF, D0
        MOVE.W      D0, SR

        RTS

*-------------ISR B--------------*
ORG $8700
