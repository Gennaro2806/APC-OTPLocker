        BEQ         RIPRISTINA_LOCK
        BRA         RICEVI_CHAR_1

RICEVI_CHAR_1:
        MOVE.B      (A1), (A0, D0.W)
        ADDI.W      #1, D0
        ADDI.W      #1, D1
        CMP.W       N,  D1
        BEQ         RICEVI_MSG_1
        BRA         RIPRISTINA_LOCK

RICEVI_MSG_1:
        MOVE.W      #0, D1
        ADDI.W      #1, D2

        CMP.W       K,  D2
        BEQ         FINE_B_1
        BRA         RIPRISTINA_LOCK
    
FINE_B_1:
        MOVE.W      #0, D2
        MOVE.W      #1, END_B

        CMP.W       K,  D3
        BEQ         VAI_FASE_2
        BRA         RIPRISTINA_LOCK

VAI_FASE_2:
        MOVE.W      F1, FASE
        BRA         RIPRISTINA_LOCK

FASE_2:
        CMP.W       #-1, POSSESSO
        BEQ         RICEVI_CHAR_2
        BRA         RILASCIA_POSSESSO

RICEVI_CHAR_2:
        MOVE.W      #0, POSSESSO
        MOVE.W      (A1), (A0, D0.W)
        ADDI.W      #1, D0
        ADDI.W      #1, D1

        CMP.W       N,  D2
        BEQ         RICEVI_MSG_2
        BRA         RILASCIA_POSSESSO

RICEVI_MSG_2:
        MOVE.W      #0, D1
        ADDI.W      #1, D2

        ADDI.W      D2, D3
        CMP.W       K, D3
        BEQ         DISABLE_PIA_C
        CMP.W       K3, D2
        BEQ         DISABLE_PIA_B
        BRA         RILASCIA_POSSESSO
    
DISABLE_PIA_C:
        MOVE.W      #0, D3
        MOVEA.W     #0, A3
DISABLE_PIA_B:
        MOVE.W      #0, D2
        MOVEA.W     #0, A2
RILASCIA_POSSESSO:
        MOVE.W      #-1, POSSESSO
    
RIPRISTINA_LOCK:
        MOVE.W      #0, LOCK
RIPRISTINA_REGISTRI:
        MOVE.W      D3, N_MSG_C
        MOVE.W      D2, N_MSG_B
        MOVE.W      D1, N_CHAR_B
        MOVE.W      D0, INDEX
        MOVEA.W     A3, PCRA_C
        MOVEA.W     A2, PCRA_B
        MOVEA.W     A1, PRA_B
        MOVEA.W     A0, BUFF
        MOVEM.L     A0-A3/D0-D3, (A7)+

*-------------ISR C--------------*
        ORG         $8900
        MOVEM.L         A0-A3/D0-D3, -(A7)
        MOVEA.W         BUFF, A0
        MOVEA.W         PRB_C, A1
        MOVEA.W         PCRB_C, A2
        MOVEA.W         PCRB_B, A3
        MOVE.W          INDEX, D0
        MOVE.W          N_CHAR_C, D1
        MOVE.W          N_MSG_C, D2
        MOVE.W          N_MSG_B, D3
        TAS             LOCK
        BNE             RIPRISTINA_REGISTRI_C
        CMP.W           F0, FASE
        BEQ             RICEVI_CHAR_1_C
        CMP.W           F1, FASE
        BEQ             RICEVI_CHAR_2_C
        BRA             RIMUOVI_LOCK
RICEVI_CHAR_1_C:
        CMP.W           #1, END_C
        BEQ             RIMUOVI_LOCK
        MOVE.B          (A1), (A0, D0.W)
        ADDI.W          #1, D0
        ADDI.W          #1, D1
        CMP.W           N, D1
        BNE             RIMUOVI_LOCK
        BRA             RICEVI_MSG_1_C

RICEVI_MSG_1_C:
        MOVE.W          #0, D1
        ADDI.W          #1, D2
        CMP.W           K, D2
        BEQ             FINE_C_1
        BRA             RIMUOVI_LOCK

FINE_C_1:
        MOVE.W          #0, D2
        MOVE.W          #1, END_C
        CMP.W           K, D3
        BEQ             VAI_FASE_2_C
        BRA             RIMUOVI_LOCK

VAI_FASE_2_C:
        MOVE.W          F1, FASE
        BRA             RIMUOVI_LOCK
RICEVI_CHAR_2_C:
        CMP.W           #-1, POSSESSO
        BEQ             RICEVI_CHAR_FASE_2_C
        BRA             RIMUOVI_LOCK
RICEVI_CHAR_FASE_2_C:
        MOVE.W          #1, POSSESSO
        MOVE.B          (A1), (A0, D0.W)
        ADDI.W          #1, D0
        ADDI.W          #1, D1
        CMP.W           K, D1
        BNE             RILASCIA_POSSESSO
        ADDI.W          #1, D2
        MOVE.W          #0, D1
        ADDI.W          D2, D3
        CMP.W           K, D3
        BEQ             DISABLE_PIA_B_2
        CMP.W           K3, D2
        BEQ             DISABLE_PIA_C_2
        BRA             RILASCIA_POSSESSO

DISABLE_PIA_B_2:
        MOVE.W          #0, D3
        MOVE.W          #0, A3
DISABLE_PIA_C_2:
        MOVE.W          #0, D2
        MOVE.W          #0, A2
RILASCIA_POSSESSO:
        MOVE.W          #-1, POSSESSO

RIMUOVI_LOCK:
        MOVE.W          #0, LOCK

RIPRISTINA_REGISTRI_C:
        MOVE.W          D3, N_MSG_B
        MOVE.W          D2, N_MSG_C
        MOVE.W          D1, N_CHAR_C
        MOVE.W          D0, INDEX
        MOVEA.W         A3, PCRB_B
        MOVEA.W         A2, PCRB_C
        MOVEA.W         A1, PRB_C
        MOVEA.W         A0, BUFF
        
