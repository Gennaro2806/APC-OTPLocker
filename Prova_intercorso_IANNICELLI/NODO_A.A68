        MOVEA.W     BUFF, A0
        MOVEA.W     PRA_B, A1
        MOVEA.W     PCRA_B, A2
        MOVEA.W     PCRA_C, A3
        MOVE.W      INDEX, D0
        MOVE.W      N_CHAR_B, D1
        MOVE.W      N_MSG_B, D2
        MOVE.W      N_MSG_C, D3
        TAS         LOCK
        BNE         RIPRISTINA_REGISTRI
        CMP.W       F0, FASE
        BEQ         FASE_1
        CMP.W       F1, FASE
        BEQ         FASE_2
        BRA         RIPRISTINA_LOCK

FASE_1:
