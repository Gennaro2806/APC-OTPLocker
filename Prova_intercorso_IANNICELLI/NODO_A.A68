*	AREA DATI 
		ORG 		$8000
N		EQU		4 
K 		EQU 		5 
NONE 		EQU		0 
B	 	EQU 		1 
C		EQU		2
PIADA_B	EQU		$2004
PIACA_B	EQU		$2005
PIADA_C	EQU		$2006
PIACA_C	EQU		$2007

FASE		DC.W		0
LOCK		DC.W		0
POSS		DC.W		NONE
BUFFB		DS.B		N 
BUFFC		DS.B		N 
CHARB		DC.W		0
MSGB		DC.W		0 
COUNTB	DC.W		0
FINEB		DC.W		0
PENDINGB	DC.W		0
CHARC		DC.W		0
MSGC		DC.W		0
COUNTC	DC.W		0
FINEC		DC.W		0
PENDINGC	DC.W		0
MSG		DC.W		0


*	MAIN
		ORG		$8200
MAIN		JSR		INIT
		MOVE.W	SR,D0
		ANDI.W	#$D8FF,D0
		MOVE.W	D0,SR
LOOP		JMP		LOOP

INIT		CLR.B		PIACA_B
		CLR.B		PIADA_B
		MOVE.B	#%00100101,PIACA_B
		CLR.B		PIACA_C
		CLR.B		PIADA_C
		MOVE.B	#%00100101,PIACA_C
		RTS

***	-----	ISR_B		------***
		ORG		$8700
ISRB		MOVEM.L	D0-D4/A0-A1,-(A7)

**PER TERMIANRE IL PROCESSO
		CMP.W	#2,FASE
		BEQ		STOPB

		MOVE.W	#1,PENDINGB

		TST.W		FASE
		BNE		CKF2
		
		CMP.W	#1,FINEB
		BEQ		IGNB

ORJMP		LEA		BUFFB,A0
		MOVE.W	CHARB,D0
		
		MOVE.B	PIADA_B,(A0,D0)
		ADDQ.W	#1,D0
		MOVE.W	D0,CHARB
		CLR.W		PENDINGB
		CMP.W		#N,D0
		BNE		EXIT
		MOVE.W	MSGB,D1
		ADDQ.W	#1,D1
		MOVE.W	D1,MSGB
		CLR.W		CHARB
		CMP.W	#K,MSGB
		BNE		EXIT
		MOVE.W	#1,FINEB
		BRA		RECC

IGNB		MOVE.B	PIADA_B,D0
		CLR.W		PENDINGB
		BRA		ENDMSG

** RECUPERO DEL CARATTERE
RECC		CMP.W 	#1,PENDINGC
		BNE		ENDMSG
		CMP.W	#1,FINEC
		BNE		ENDMSG
		MOVE.W	CHARC,D2
		ADDQ.W	#1,D2
		CLR.W		PENDINGC
		MOVE.W	D2,CHARC
		SUBQ.W	#1,D2
		LEA		BUFFC,A0
		MOVE.B	PIADA_C,(A0,D2)
	
ENDMSG		CMP.W		#1,FINEC
		BNE		EXIT
		MOVE.W	FASE,D3
		ADDQ.W	#1,D3
		MOVE.W	D3,FASE
		BRA		EXIT

FASE2		CMP.W	#NONE,POSS
		BNE		CKPOSS
		TAS		LOCK
		BNE		EXIT
		CMP.W	#NONE,POSS
		BNE		RELEASE
		MOVE.W	#B,POSS
		
RELEASE	CLR.W		LOCK
		BRA		CKPOSS

STOPB		MOVE.B	PIADA_B,D0
		BRA		EXIT
		
EXIT		MOVEM.L	(A7)+,D0-D4/A0-A1
		RTE

CKPOSS	CMP.W		#B,POSS
		BNE		EXIT
		CMP.W	#1,PENDINGB
		BNE		EXIT
		LEA		BUFFB,A0
		MOVE.W	CHARB,D0
		MOVE.W	MSG,D1
		MOVE.W	COUNTB,D2
		MOVE.B	PIADA_B,(A0,D0)
		CLR.W		PENDINGB
		ADDQ.W	#1,D0
		MOVE.W	D0,CHARB
		CMP.W	#N,CHARB
		BNE		EXIT
		ADDQ.W	#1,D1
		MOVE.W	D1,MSG
		CLR.W		CHARB
		ADDQ.W	#1,D2
		MOVE.W	D2,COUNTB

		CMP.W	#K,D1
		BNE		CNGPOSS
		MOVE.W	#2,FASE
		BRA		EXIT
		
CNGPOSS		CMP.W	#(K-1),D2
		BNE		ELSEPOSS
		MOVE.W	#C,POSS
		BRA		REC

ELSEPOSS	CLR.W		POSS


REC		CMP.W		#1,PENDINGC
		BNE		EXIT
		MOVE.W	#C,POSS
		CLR.W		PENDINGC
		MOVE.W	CHARC,D3
		ADD.W		#1,D3
		MOVE.W	D3,CHARC
		SUB.W		#1,D3
		LEA		BUFFC,A1
		MOVE.B	PIADA_C,(A1,D3)
		BRA		EXIT

CKF2		JMP		FASE2

***	-----	ISR_C		------***
		ORG		$8900
ISRC		MOVEM.L	D0-D4/A0-A1,-(A7)
**PER FINIRE PROCESSO
		CMP.W	#2,FASE
		BEQ		STOPC

		MOVE.W	#1,PENDINGC
		TST.W		FASE
		BNE		CF2C

		CMP.W	#1,FINEC
		BEQ		IGNC

ORJMPC	LEA		BUFFC,A0
		MOVE.W	CHARC,D0

		MOVE.B	PIADA_C,(A0,D0)
		ADDQ.W	#1,D0
		MOVE.W	D0,CHARC
		CLR.W		PENDINGC
		CMP.W		#N,D0
		BNE		EXITC
		MOVE.W	MSGC,D1
		ADDQ.W	#1,D1
		MOVE.W	D1,MSGC
		CLR.W		CHARC
		CMP.W	#K,D1
		BNE		EXITC
		
		MOVE.W	#1,FINEC
		BRA		RECB
IGNC		MOVE.B	PIADA_C,D0
		CLR.W		PENDINGC
		BRA		ENDMSGC

RECB		CMP.W	#1,PENDINGB
		BNE		ENDMSGC
		CMP.W	#1,FINEB
		BNE		ENDMSGC
		MOVE.W	CHARB,D2
		ADDQ.W	#1,D2
		CLR.W		PENDINGB
		MOVE.W	D2,CHARB
		SUBQ.W	#1,D2	
		LEA		BUFFB,A0
		MOVE.B	PIADA_B,(A0,D2)	

ENDMSGC	CMP.W		#1,FINEB
		BNE		EXITC
		MOVE.W	FASE,D3
		ADDQ.W	#1,D3
		MOVE.W	D3,FASE
		BRA		EXITC

FASE2C	CMP.W	#NONE,POSS
		BNE		CKPOSSC
		TAS		LOCK
		BNE		EXITC
		CMP.W		#NONE,POSS
		BNE		RELEASEC
		MOVE.W	#C,POSS
		
RELEASEC	CLR.W		LOCK
		BRA		CKPOSSC

STOPC		MOVE.B	PIADA_C,D0
		BRA		EXITC

EXITC		MOVEM.L	(A7)+,D0-D4/A0-A1
		RTE

CKPOSSC	CMP.W		#C,POSS
		BNE		EXITC
		CMP.W	#1,PENDINGC
		BNE		EXITC
		LEA		BUFFC,A0
		MOVE.W	CHARC,D0
		MOVE.W	MSG,D1
		MOVE.W	COUNTC,D2
		MOVE.B	PIADA_C,(A0,D0)
		CLR.W		PENDINGC
		ADDQ.W	#1,D0
		MOVE.W	D0,CHARC
		CMP.W		#N,D0
		BNE		EXITC
		ADDQ.W	#1,D1
		MOVE.W	D1,MSG
		CLR.W		CHARC
		ADDQ.W	#1,D2
		MOVE.W	D2,COUNTC
		
		CMP.W	#K,D1
		BNE		CNGPOSC
		MOVE.W	#2,FASE
		BRA		EXITC

CNGPOSC	CMP.W	#(K-1),D2
		BNE		ELSEPOSC
		MOVE.W	#B,POSS
		BRA		RCVC

ELSEPOSC	CLR.W		POSS


RCVC		CMP.W		#1,PENDINGB
		BNE		EXITC
		MOVE.W	#B,POSS
		CLR.W		PENDINGB
		MOVE.W	CHARB,D3
		ADDQ.W	#1,D3
		MOVE.W	D3,CHARB
		SUBQ.W	#1,D3
		LEA		BUFFB,A1
		MOVE.B	PIADA_B,(A1,D3)
		BRA		EXITC

CF2C		JMP		FASE2C
		
		END		MAIN








