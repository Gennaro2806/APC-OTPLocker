


*definizioni costanti
PIAABD	EQU     $2004       ; Registro Dati PIA B 
PIAABC	EQU	$2005       ;Registro Controllo PIA B		
PIAACD	EQU	$2008	     ;Registro Dato PIA C
PIAACC		EQU     $2009       ; Registro Controllo PIA C 

N	EQU     4          	
K	EQU     5           	

POSS_NONE   EQU     0           
POSS_B      	EQU     1           
POSS_C      	EQU     2           

*definizioni Variabili
	ORG	$8000
LOCK        	DC.W    0
FASE        	DC.W    1
POSSESSO    	DC.W    0
PEND_B   	DC.W    0
PEND_C   	DC.W    0
END_B       	DC.W    0
END_C       	DC.W    0
END_TOT     	DC.W    0
CHAR_B      	DC.W    0
CHAR_C      	DC.W    0
MESS_TOT      DC.W    0
MESS_B      	DC.W    0
MESS_C	DC.W	 0
INVIO_B     	DC.W    0
INVIO_C     	DC.W    0
BUFF_B      	DS.B    N*K
BUFF_C      	DS.B    N*K

*main
	ORG	$8200
MAIN	JSR INIT_PIA
	
	MOVE.W	SR,D0
	ANDI.W	#$D8FF,D0
	MOVE.W	D0,SR

LOOP 	JMP	LOOP


INIT_PIA	MOVE.B	#0,PIAABC
		MOVE.B	#0,PIAABD
		MOVE.B	#%00100101,PIAABC

		MOVE.B	#0,PIAACC
		MOVE.B	#0,PIAACD
		MOVE.B	#%00100101,PIAACC
		RTS

*ISR B
	ORG	$8700
ISR_B		
		MOVEM.L 	D0-D2/A0-A1,-(SP)    
		MOVE.W	#1,PEND_B         
    		CMPI.W 	#1,FASE              
		BNE     	FASE_2
FASE_1	CMP.W	#0,END_B	
		BNE		RETURN

		MOVEA.L 	#PIAABD,A0           ; Carica indirizzo dati PIA B (preparazione per la lettura)
   		MOVEA.L 	#BUFF_B,A1           
   		MOVE.W  	CHAR_B,D1            
    
   		MOVE.B  	(A0),(A1,D1.W)       ;LETTURA B
    		CLR.W  	PEND_B        
    
    		ADDQ.W  	#1,CHAR_B            
    		CMPI.W  	#N,CHAR_B           
    		BNE     	RETURN
   		
		CLR.W 	CHAR_B            
    		ADDQ.W  	#1,MESS_B            
    
    		CMPI.W  	#K,MESS_B            
    		BNE     	RETURN
    
    		MOVE.W 	#1,END_B             ; endB = 1
    		CMP.W   	#0,END_C                 
    		BEQ     	RETURN
		
		MOVE.W  	#2,FASE              ; FASE = 2
CHEK_C1    	CMP.W  	#0,PEND_C             
    		BEQ     	RETURN
    
    		MOVE.W  	#POSS_C,POSSESSO     ; possesso = C (perché adesso entriamo in fase 2)
    		CLR.W  	PEND_C        
		MOVE.W  	CHAR_C,D2	        ;Sposto prima il CharC perché lo incremento prima di fare la lettura
		ADDQ.W  	#1,CHAR_C            ; incremento prima il carattere e poi sblocco la PIA
    
    		MOVEA.L	#PIAACD,A0           ; Sblocco PIA C
    		MOVEA.L 	#BUFF_C,A1
    		MOVE.B  	(A0),(A1,D2.W)       ; buffC[charC] = readPIA(C)
    		BRA     	RETURN

FASE_2	CMP.W   	#0,END_TOT               
   	 	BNE     	RETURN
    
    		CMPI.W  	#POSS_NONE,POSSESSO  
    		BNE     	CHECK_READ
    
    		TAS     		LOCK                  
    		BNE     	RETURN
    
    		CMPI.W  	#POSS_NONE,POSSESSO 
   	 	BNE     	UNLOCK_RET
    		MOVE.W 	#POSS_B,POSSESSO
		CLR.W		LOCK
		BRA		CHECK_READ
		
UNLOCK_RET	CLR.W		LOCK
		BRA 		RETURN	

CHECK_READ	CMP.W  	#POSS_B,POSSESSO     
    		BNE     	RETURN
    		CMP.W   	#1,PEND_B             
    		BNE     	RETURN	
		
		MOVEA.L 	#PIAABD,A0           ;preparazione lettura
    		MOVEA.L 	#BUFF_B,A1
    		MOVE.W  	CHAR_B,D1
    		MOVE.B  	(A0),(A1,D1.W)	;lettura B
    
    		ADDQ.W  	#1,CHAR_B            
    		CLR.W  	PEND_B         
    
    		CMP.W  	#N,CHAR_B            
    		BNE     	RETURN
		
		CLR.W  	CHAR_B	;caratteri finiti, incremento mess
    		ADDQ.W  	#1,MESS_TOT              
    		ADDQ.W  	#1,INVIO_B	

		MOVE.W  	#K,D0                 ; devo verificare se anche C ha inviato almeno un messaggio
    		SUBQ.W  	#1,D0               
   		CMP.W   	MESS_TOT,D0              
    		BNE     	CHECK_END

		CMP.W  	#0,INVIO_C              
    		BNE     	RELEASE
    		MOVE.W  	#POSS_C,POSSESSO     ; Forza possesso a C perché ancora non ha inviato il messaggio
    		BRA     	CHECK_C

RELEASE	MOVE.W  	#POSS_NONE,POSSESSO
		BRA     	CHECK_C

CHECK_END   CMPI.W   	#K,MESS_TOT               
    		BNE     	RELEASE
    		MOVE.W  	#1,END_TOT           ; END = 1
    		MOVE.W  	#POSS_NONE,POSSESSO

CHECK_C    	CMP.W   	#0,PEND_C             
    		BEQ     	RETURN
    		CMP.W   	#0,END_TOT
    		BNE     	RETURN

		MOVE.W 	#POSS_C,POSSESSO     ; possesso = C
    		CLR.W 	PEND_C         
		MOVE.W  	CHAR_C,D2	        ;Sposto prima il CharC perché lo incremento prima di fare la lettura
		ADDQ.W  	#1,CHAR_C            ; incremento prima il carattere e poi sblocco la PIA

    		MOVEA.L 	#PIAACD,A0           ; Leggi da C per sbloccare 
    		MOVEA.L 	#BUFF_C,A1
    		MOVE.B  	(A0),(A1,D2.W)
    
RETURN    	MOVEM.L 	(SP)+,D0-D2/A0-A1    ; Ripristino registri
    		RTE

*ISR C
		ORG	$8900              
ISR_C		
		MOVEM.L 	D0-D2/A0-A1,-(SP)    
		MOVE.W	#1,PEND_C         
    		CMPI.W 	#1,FASE              
		BNE     	FASEC_2

FASEC_1	CMP.W	#0,END_C	
		BNE		RET_C

		MOVEA.L 	#PIAACD,A0           ; Carica indirizzo dati PIA C
   		MOVEA.L 	#BUFF_C,A1           
   		MOVE.W  	CHAR_C,D2            
    
   		MOVE.B  	(A0),(A1,D2.W)       ; LETTURA C
    		MOVE.W  	#0,PEND_C        
    
    		ADDQ.W  	#1,CHAR_C             
    		CMPI.W  	#N,CHAR_C           
    		BNE     	RET_C
   		
		MOVE.W  	#0,CHAR_C            
    		ADDQ.W  	#1,MESS_C            
    
    		CMPI.W  	#K,MESS_C            
    		BNE     	RET_C
    
   		MOVE.W 	#1,END_C             ; endC = 1
    		CMP.W   	#0,END_B                 
    		BEQ     	RET_C
		
		MOVE.W  	#2,FASE              ; FASE = 2
CHEK_B1    	CMP.W  	#0,PEND_B             
    		BEQ     	RET_C
    
    		MOVE.W  	#POSS_B,POSSESSO     ; possesso = B (entriamo in fase 2)
    		MOVE.W  	#0,PEND_B        
		MOVE.W  	CHAR_B,D1	         ; Sposto prima il CharB 
		ADDQ.W  	#1,CHAR_B            ; incremento prima di sbloccare la PIA
    
    		MOVEA.L	#PIAABD,A0           ; Sblocco PIA B
    		MOVEA.L 	#BUFF_B,A1
    		MOVE.B  	(A0),(A1,D1.W)       ; buffB[charB] = readPIA(B)
    		BRA     	RET_C


FASEC_2	CMP.W   	#0,END_TOT               
   	 	BNE     	RET_C
    
    		CMPI.W  	#POSS_NONE,POSSESSO  
    		BNE     	CHECK_R_C
    
    		TAS     		LOCK                  
    		BNE     	RET_C
    
    		CMPI.W  	#POSS_NONE,POSSESSO 
   	 	BNE		UNL_RET_C
    		MOVE.W 	#POSS_C,POSSESSO
		MOVE.W	#0,LOCK
		BRA		CHECK_R_C

UNL_RET_C	MOVE.W	#0,LOCK
		BRA 		RET_C	

CHECK_R_C	CMP.W  	#POSS_C,POSSESSO     
    		BNE     	RET_C
    		CMP.W   	#1,PEND_C             
    		BNE     	RET_C	
		
		MOVEA.L 	#PIAACD,A0           ; preparazione lettura
    		MOVEA.L 	#BUFF_C,A1
    		MOVE.W  	CHAR_C,D2
    		MOVE.B  	(A0),(A1,D2.W)	     ; lettura C
    
    		ADDQ.W  	#1,CHAR_C            
    		MOVE.W  	#0,PEND_C         
    
    		CMP.W  	#N,CHAR_C            
    		BNE     	RET_C
		
		MOVE.W  	#0,CHAR_C	         ; caratteri finiti, incremento mess
    		ADDQ.W  	#1,MESS_TOT              
    		ADDQ.W  	#1,INVIO_C	

		MOVE.W  	#K,D0                 ; verifico se B ha inviato almeno un messaggio
    		SUBQ.W  	#1,D0               
   		CMP.W   	MESS_TOT,D0              
    		BNE     	CHECK_E_C

		CMP.W  	#0,INVIO_B              
    		BNE     	RELEASE_C
    		MOVE.W  	#POSS_B,POSSESSO     ; Forza possesso a B perché non ha inviato messaggi
    		BRA     	CHECK_B

RELEASE_C	MOVE.W	#POSS_NONE,POSSESSO
		BRA     	CHECK_B

CHECK_E_C	CMPI.W	#K,MESS_TOT               
    		BNE     	RELEASE_C
    		MOVE.W  	#1,END_TOT           ; END = 1
    		MOVE.W  	#POSS_NONE,POSSESSO

CHECK_B	CMP.W	#0,PEND_B             
    		BEQ     	RET_C
    		CMP.W   	#0,END_TOT
    		BNE     	RET_C

		MOVE.W 	#POSS_B,POSSESSO     ; possesso = B
    		MOVE.W  	#0,PEND_B         
		MOVE.W  	CHAR_B,D1	         ; Sposto prima il CharB 
		ADDQ.W  	#1,CHAR_B            ; incremento prima il carattere

    		MOVEA.L 	#PIAABD,A0           ; Leggi da B per sbloccare 
    		MOVEA.L 	#BUFF_B,A1
    		MOVE.B  	(A0),(A1,D1.W)
RET_C		MOVEM.L	(SP)+,D0-D2/A0-A1
    		RTE

		END 		MAIN
		

























